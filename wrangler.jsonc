{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regie-essence-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "regie-essence",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
